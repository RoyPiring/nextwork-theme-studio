{
  "manifest_version": 3,
  "name": "NextWork Theme Studio",
  "version": "1.0.0",
  "description": "Personal, fully customizable dark themes for nextwork.ai. Edit the palette live, VS Code style.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://nextwork.ai/*",
        "*://*.nextwork.ai/*"
      ],
      "js": [
        "src/scenes.js",
        "src/theme-engine.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "NextWork Theme Studio",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "toggle-theme": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Toggle the NextWork theme on/off"
    }
  }
}
